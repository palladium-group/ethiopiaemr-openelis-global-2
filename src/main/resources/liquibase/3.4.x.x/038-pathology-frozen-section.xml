<?xml version="1.0" encoding="utf-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
      Frozen section histopathology subtype support:
      - pathology_sample.subtype (BIOPSY | FROZEN), like cytology_sample.subtype
      - linked_from_pathology_sample_id for permanent Biopsy created after FS sign-out
      - Frozen section examination test (placeholder LOINC 97005-7) matching OpenMRS order concept
    -->

    <changeSet id="038-pathology-subtype-and-link" author="openelis">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="pathology_sample" columnName="subtype"/>
            </not>
        </preConditions>
        <comment>Add pathology subtype (BIOPSY/FROZEN) and optional link to parent frozen case</comment>
        <addColumn schemaName="clinlims" tableName="pathology_sample">
            <column name="subtype" type="VARCHAR(50)" defaultValue="BIOPSY">
                <constraints nullable="false"/>
            </column>
            <column name="linked_from_pathology_sample_id" type="INTEGER"/>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="pathology_sample" columnName="subtype"/>
            <dropColumn schemaName="clinlims" tableName="pathology_sample" columnName="linked_from_pathology_sample_id"/>
        </rollback>
    </changeSet>

    <changeSet id="038-frozen-section-examination-test" author="openelis">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(*) from clinlims.test where description = 'Frozen section examination'</sqlCheck>
            <sqlCheck expectedResult="1">select count(*) from clinlims.test_section where name = 'Pathology'</sqlCheck>
        </preConditions>
        <comment>Create Frozen section examination test (placeholder LOINC 97005-7) in Pathology section</comment>
        <insert schemaName="clinlims" tableName="localization">
            <column name="id" valueSequenceNext="localization_seq" />
            <column name="lastupdated" valueComputed="${now}" />
            <column name="description" value="frozen section test name (038)" />
            <column name="english" value="Frozen section examination" />
            <column name="french" value="Frozen section examination"/>
        </insert>
        <insert schemaName="clinlims" tableName="localization">
            <column name="id" valueSequenceNext="localization_seq" />
            <column name="lastupdated" valueComputed="${now}" />
            <column name="description" value="frozen section test reporting name (038)" />
            <column name="english" value="Frozen section examination" />
            <column name="french" value="Frozen section examination"/>
        </insert>
        <insert schemaName="clinlims" tableName="test">
            <column name="id" valueNumeric="nextval('test_seq')"/>
            <column name="description" value="Frozen section examination"/>
            <column name="lastupdated" valueDate="now()" />
            <column name="is_active" value="Y" />
            <column name="is_reportable" value="Y" />
            <column name="orderable" valueBoolean="true" />
            <column name="loinc" value="97005-7" />
            <column name="test_section_id" valueComputed="(select id from test_section where name = 'Pathology' limit 1)" />
            <column name="name" value="Frozen section examination" />
            <column name="name_localization_id" valueComputed="(select id from localization where description = 'frozen section test name (038)' limit 1)" />
            <column name="reporting_name_localization_id" valueComputed="(select id from localization where description = 'frozen section test reporting name (038)' limit 1)" />
            <column name="guid" value="a7c1e2f1-9700-4a26-9d3b-0e1f2a3b4c07"/>
        </insert>
    </changeSet>

    <changeSet id="038-frozen-section-sample-type" author="openelis">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(*) from clinlims.test where description = 'Frozen section examination'</sqlCheck>
            <sqlCheck expectedResult="1">select count(*) from clinlims.type_of_sample where description = 'Histopathology specimen'</sqlCheck>
            <sqlCheck expectedResult="0">select count(*) from clinlims.sampletype_test st join clinlims.test t on t.id = st.test_id where t.description = 'Frozen section examination'</sqlCheck>
        </preConditions>
        <insert schemaName="clinlims" tableName="sampletype_test">
            <column name="id" valueSequenceNext="sample_type_test_seq"/>
            <column name="sample_type_id" valueComputed="(select id from clinlims.type_of_sample where description = 'Histopathology specimen' limit 1)"/>
            <column name="test_id" valueComputed="(select id from clinlims.test where description = 'Frozen section examination' limit 1)"/>
        </insert>
    </changeSet>

    <changeSet id="038-frozen-section-remark" author="openelis">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(*) from clinlims.test where description = 'Frozen section examination'</sqlCheck>
            <sqlCheck expectedResult="0">select count(*) from clinlims.test_result tr join clinlims.test t on t.id = tr.test_id where t.description = 'Frozen section examination'</sqlCheck>
        </preConditions>
        <insert schemaName="clinlims" tableName="test_result">
            <column name="id" valueSequenceNext="test_result_seq"/>
            <column name="test_id" valueComputed="(select id from clinlims.test where description = 'Frozen section examination' limit 1)"/>
            <column name="tst_rslt_type" value="R"/>
            <column name="sort_order" value="1"/>
            <column name="is_active" value="t"/>
            <column name="lastupdated" valueComputed="${now}"/>
        </insert>
    </changeSet>

</databaseChangeLog>
