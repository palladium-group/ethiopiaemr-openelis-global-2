<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <property name="now" value="now()" dbms="postgresql"/>

    <changeSet id="044-pathology-accession-by-service-category-config" author="pathology-accession">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information WHERE name = 'pathologyAccessionByCategory'</sqlCheck>
        </preConditions>
        <comment>When true, histopathology and cytopathology cases get their own accession number sequences</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id" valueSequenceNext="site_information_seq" />
            <column name="name" value="pathologyAccessionByCategory" />
            <column name="lastupdated" valueComputed="${now}" />
            <column name="description" value="Separate accession number sequences for histopathology and cytopathology cases" />
            <column name="value" value="true" />
            <column name="encrypted" value="false" />
            <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'sampleEntryConfig')" />
            <column name="value_type" value="boolean" />
            <column name="instruction_key" value="instructions.path.accession.category" />
            <column name="group" value="0" />
        </insert>
    </changeSet>

</databaseChangeLog>
