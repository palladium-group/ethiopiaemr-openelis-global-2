<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-reception-approval-required-config" author="sample-reception">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM clinlims.site_information WHERE name = 'receptionApprovalRequired'</sqlCheck>
        </preConditions>
        <comment>When true, collected samples require reception approval before analyses become Not Tested</comment>
        <insert schemaName="clinlims" tableName="site_information">
            <column name="id" valueSequenceNext="site_information_seq" />
            <column name="name" value="receptionApprovalRequired" />
            <column name="lastupdated" valueComputed="${now}" />
            <column name="description" value="Require reception approval after collection before tests enter workplan or results" />
            <column name="value" value="false" />
            <column name="encrypted" value="false" />
            <column name="domain_id" valueComputed="(SELECT id FROM site_information_domain WHERE name = 'sampleEntryConfig')" />
            <column name="value_type" value="boolean" />
            <column name="instruction_key" value="instructions.reception.approval.required" />
            <column name="group" value="0" />
        </insert>
    </changeSet>

</databaseChangeLog>
