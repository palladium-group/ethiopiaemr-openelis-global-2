<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!--
        Pathology Embedding (Step 6): per-cassette embedded timestamp. Null means not yet
        embedded; when every block on the case has a value, status advances EMBEDDING → SLICING.
    -->
    <changeSet id="030-pathology-block-embedded-at" author="openelis">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="clinlims" tableName="pathology_block" columnName="embedded_at"/>
            </not>
        </preConditions>
        <comment>Add pathology_block.embedded_at for Embedding checklist</comment>
        <addColumn schemaName="clinlims" tableName="pathology_block">
            <column name="embedded_at" type="datetime">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="pathology_block" columnName="embedded_at"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
