<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet author="openelis" id="020-add-reception-menu-item">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM clinlims.menu WHERE element_id = 'menu_sample_reception'
            </sqlCheck>
        </preConditions>
        <comment>Add Sample Reception menu item under Sample menu</comment>
        <insert tableName="menu" schemaName="clinlims">
            <column name="id" valueSequenceNext="menu_seq" />
            <column name="parent_id"
                valueComputed="(SELECT id FROM clinlims.menu WHERE element_id = 'menu_sample')" />
            <column name="presentation_order" value="6" />
            <column name="element_id" value="menu_sample_reception" />
            <column name="action_url" value="/Reception" />
            <column name="display_key" value="banner.menu.reception" />
            <column name="tool_tip_key" value="banner.menu.reception.tooltip" />
            <column name="new_window" valueBoolean="false" />
            <column name="is_active" valueBoolean="true" />
            <column name="hide_in_old_ui" valueBoolean="true" />
        </insert>
    </changeSet>
</databaseChangeLog>
