<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-04-15-analysis-referring-service-request-id" author="openelis">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="analysis" schemaName="clinlims"/>
            <not>
                <columnExists tableName="analysis" schemaName="clinlims" columnName="referring_service_request_id"/>
            </not>
        </preConditions>
        <comment>OpenMRS ServiceRequest id per analysis for grouped electronic orders (Stage A)</comment>
        <addColumn schemaName="clinlims" tableName="analysis">
            <column name="referring_service_request_id" type="VARCHAR(60)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn schemaName="clinlims" tableName="analysis" columnName="referring_service_request_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
